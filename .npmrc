# Project-level npm configuration.
# These override the user's global ~/.npmrc for this repository.

# The global ~/.npmrc on this machine sets legacy-peer-deps=true, which silently
# accepts incompatible peer dependencies. That is exactly how an unsupported
# TypeScript or Vitest would end up installed against Angular 22 without a warning.
# This repository depends on peer ranges being enforced. See ANGULAR_PROJECT_CONTEXT.md §5.
legacy-peer-deps=false

# Refuse to install when the Node runtime does not satisfy package.json "engines".
# Makes the Phase 0 runtime check enforced by tooling rather than by discipline.
engine-strict=true

# The stack is version-locked; record exact versions rather than ranges.
save-exact=true
