# Mock API settings - every one optional; the defaults are in src/config.ts.
# Copy to .env (git-ignored) and run `node --env-file=.env src/main.ts`.
# Nothing here is a secret: the mock has no keys, no passwords, no tokens to keep.

MOCK_API_PORT=4300
MOCK_API_SEED=20260920
MOCK_API_CUSTOMERS=50000
MOCK_API_CORS_ORIGINS=http://localhost:4200
MOCK_API_ACCESS_TTL=900
MOCK_API_REFRESH_TTL=28800
MOCK_API_RATE_LIMIT=600
MOCK_API_SECURE_COOKIES=false
# debug | info | warn | error - stdout only; /api/_mock/logs keeps every level
MOCK_API_LOG_LEVEL=info

# Fault and latency controls (also adjustable at runtime: PATCH /api/_mock/controls)
MOCK_API_LATENCY_MS=120
MOCK_API_JITTER_MS=80
MOCK_API_ERROR_RATE=0
