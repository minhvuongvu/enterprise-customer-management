{
  "name": "@ecm/contracts",
  "version": "0.0.0",
  "description": "API contract shared by the Angular application and the mock backend",
  "private": true,
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./testing": {
      "types": "./dist/testing/index.d.ts",
      "default": "./dist/testing/index.js"
    }
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "watch": "tsc -p tsconfig.json --watch",
    "typecheck": "tsc -p tsconfig.test.json",
    "test": "vitest run",
    "test:coverage": "vitest run --coverage"
  },
  "dependencies": {
    "zod": "4.6.5"
  },
  "devDependencies": {
    "@vitest/coverage-v8": "4.1.11",
    "typescript": "6.0.3",
    "vitest": "4.1.11"
  },
  "files": [
    "dist"
  ]
}
