{
  "name": "enterprise-customer-management",
  "version": "0.0.0",
  "private": true,
  "description": "Enterprise-oriented Angular learning repository - Customer Management",
  "license": "UNLICENSED",
  "packageManager": "npm@11.19.0",
  "engines": {
    "node": "^22.22.3 || ^24.15.0 || >=26.0.0"
  },
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "start": "npm run start --workspace @ecm/web",
    "build": "npm run build --workspaces --if-present",
    "test": "npm run test --workspaces --if-present",
    "lint": "npm run lint --workspaces --if-present",
    "typecheck": "tsc -p tsconfig.json --noEmit && npm run typecheck --workspaces --if-present",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "e2e": "playwright test",
    "e2e:ui": "playwright test --ui",
    "verify": "npm run format:check && npm run lint && npm run typecheck && npm run test && npm run build && npm run e2e"
  },
  "devDependencies": {
    "@axe-core/playwright": "4.13.0",
    "@playwright/test": "1.63.0",
    "@types/node": "24.13.6",
    "prettier": "3.9.8",
    "typescript": "6.0.3"
  }
}
